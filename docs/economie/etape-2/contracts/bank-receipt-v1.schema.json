{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:renblood:economy:bank:v1:receipt",
  "title": "Bank v1 receipt (implemented)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "operation_id",
    "idempotency_key",
    "type",
    "state",
    "actor_id",
    "amount",
    "currency",
    "created_at",
    "revision"
  ],
  "properties": {
    "api_version": {
      "const": "1"
    },
    "operation_id": {
      "type": "string",
      "format": "uuid"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "request_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "type": {
      "enum": [
        "DEPOSIT",
        "WITHDRAW",
        "CREDIT",
        "DEBIT",
        "OPENING_BALANCE",
        "COMPENSATION"
      ]
    },
    "state": {
      "enum": [
        "PREPARED",
        "RESERVED",
        "CONFIRMED",
        "CANCELLED",
        "RECONCILIATION_REQUIRED"
      ]
    },
    "actor_id": {
      "type": "string",
      "minLength": 1
    },
    "amount": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$",
      "description": "Semantic validation must also reject values above signed int64 max."
    },
    "currency": {
      "const": "IRON"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "source_account_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "destination_account_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "original_operation_id": {
      "type": "string",
      "format": "uuid"
    },
    "price_version": {
      "type": "string"
    },
    "rule_version": {
      "type": "string"
    },
    "tax": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$",
      "description": "Semantic validation must also reject values above signed int64 max."
    },
    "proof_id": {
      "type": "string"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "owner_id": {
      "type": "string"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "direction": {
      "enum": [
        "CREDIT",
        "DEBIT"
      ]
    },
    "reviewed_by": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "COMPENSATION"
          }
        }
      },
      "then": {
        "required": [
          "original_operation_id",
          "reason"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "CONFIRMED"
          }
        }
      },
      "then": {
        "required": [
          "proof_id",
          "rule_version"
        ]
      }
    }
  ]
}
